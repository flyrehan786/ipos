# Database connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=pos_db
DB_PORT=3306

# Authentication
# Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me_to_a_long_random_secret
# Separate secret for refresh tokens (generate the same way).
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Server
PORT=4000
